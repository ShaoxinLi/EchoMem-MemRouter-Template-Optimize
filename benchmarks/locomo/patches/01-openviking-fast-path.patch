+    async def execute_instruction(
+        self,
+        query: str,
+        ctx: RequestContext,
+        target_uri: Union[str, List[str]] = "",
+        search_mode: str = "find",
+        limit: int = 10,
+        score_threshold: Optional[float] = None,
+        filter: Optional[Dict] = None,
+        level: Optional[List[int]] = None,
+    ) -> Any:
+        """Execute a pre-computed instruction without IntentAnalyzer (MemRouter fast path).
+
+        This method bypasses IntentAnalyzer entirely. The caller (MemRouter)
+        is responsible for having already determined target_uri, search_mode,
+        and context_type.
+
+        Args:
+            query: Raw user query.
+            ctx: Request context (for ACL / telemetry).
+            target_uri: Target directory URI(s).
+            search_mode: "find" or "search".
+            limit: Max results.
+            score_threshold: Score threshold.
+            filter: Metadata filters.
+            level: Filter by level (0=abstract, 1=overview, 2=file).
+
+        Returns:
+            FindResult — same shape as search() / find().
+        """
+        _ensure_non_empty_query(query)
+        target_uri = validate_optional_viking_uris(target_uri, field_name="target_uri")
+        viking_fs = self._ensure_initialized()
+
+        if search_mode == "find":
+            result = await viking_fs.find(
+                query=query,
+                ctx=ctx,
+                target_uri=target_uri,
+                limit=limit,
+                score_threshold=score_threshold,
+                filter=filter,
+                level=level,
+            )
+        else:
+            result = await viking_fs.search(
+                query=query,
+                ctx=ctx,
+                target_uri=target_uri,
+                limit=limit,
+                score_threshold=score_threshold,
+                filter=filter,
+                level=level,
+            )
+        return result
